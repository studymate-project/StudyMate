# Generate a unique value, for example with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True


# PostgreSQL is required for both local development and production.
DATABASE_URL=postgresql://studymate:change-me@127.0.0.1:5432/studymate

# Django closes the database connection after each request by default. Set a
# bounded value only when the deployment's worker/thread count is sized for it.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Maximum size for a single uploaded Resource file (20 MiB by default).
RESOURCE_MAX_FILE_SIZE_BYTES=20971520

# Optional Cloudinary media storage foundation. Leave these unset for local
# filesystem uploads. Configure all three together to enable the named
# cloudinary_media storage alias; existing Resource files remain unchanged.
# Keep the API secret server-side and never expose it to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_FOLDER=studymate/resources
#PRESET_NAME=studymate

# Comma-separated values; do not include a URL scheme in ALLOWED_HOSTS.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT authentication (the signing key defaults to SECRET_KEY when omitted).
JWT_SIGNING_KEY=replace-with-a-separate-jwt-signing-key
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ACCESS_COOKIE_NAME=studymate_access
JWT_REFRESH_COOKIE_NAME=studymate_refresh
JWT_COOKIE_SAMESITE=Lax

# Keep JWT_COOKIE_SECURE unset for local HTTP; set it to True in HTTPS production.
# JWT_COOKIE_SECURE=True
# JWT_COOKIE_DOMAIN=.example.com
# JWT_ACCESS_COOKIE_PATH=/
# JWT_REFRESH_COOKIE_PATH=/api/auth/

# Production only (DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# DRF API throttling. Defaults are conservative and may be tuned per deployment.
# THROTTLE_ANON_RATE=300/hour
# THROTTLE_USER_RATE=1200/hour
# THROTTLE_AUTH_LOGIN_RATE=30/minute
# THROTTLE_AUTH_SIGNUP_RATE=20/hour
# THROTTLE_AUTH_REFRESH_RATE=60/minute
# THROTTLE_RESOURCE_WRITE_RATE=60/hour
# THROTTLE_QUESTION_WRITE_RATE=60/hour
# THROTTLE_ANSWER_WRITE_RATE=120/hour
# THROTTLE_INTERACTION_WRITE_RATE=300/minute
# THROTTLE_ONBOARDING_WRITE_RATE=60/hour
# THROTTLE_EVENT_WRITE_RATE=300/minute
