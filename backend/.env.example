# Generate a unique value, for example with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True


# PostgreSQL is required for both local development and production.
DATABASE_URL=postgresql://studymate:change-me@127.0.0.1:5432/studymate
# Leave unset for local PostgreSQL unless TLS is configured. Render production
# should set DB_SSLMODE=require (the production default is also require).
# DB_SSLMODE=require


# Django closes the database connection after each request by default. Set a
# bounded value only when the deployment's worker/thread count is sized for it.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Slow-query logs include duration, SQL verb, method and route only; SQL text
# and parameters are never logged. Production defaults to enabled at 250 ms;
# local development stays quiet unless explicitly enabled.
DB_SLOW_QUERY_LOGGING_ENABLED=False
DB_SLOW_QUERY_THRESHOLD_MS=250

# Shared Redis cache for production throttling. Leave unset for local
# development; production must provide a secret-managed Redis URL.
# For Upstash, use the TLS URL copied from its Connect/TCP settings.
# REDIS_URL=rediss://default:<YOUR_TOKEN>@<YOUR_ENDPOINT>:6379

# Subject recommendation cache version keys expire after this many seconds;
# keep it at least as large as the maximum recommendation value TTL.
SUBJECT_RECOMMENDATION_CACHE_VERSION_TTL_SECONDS=1800

# Optional namespace-scoped cache counters. Enabling this adds one best-effort
# counter write per subject-cache read; provider memory and billing metrics are
# still obtained from the Redis provider dashboard.
CACHE_METRICS_ENABLED=False


# Celery may reuse REDIS_URL, or use a separate broker. The password must be
# URL-encoded if it contains reserved URL characters.
# CELERY_BROKER_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>:6379/0?ssl_cert_reqs=required
# Celery bounds each task with a soft timeout followed by a hard kill. Keep the
# soft limit lower than the hard limit; values are seconds.
CELERY_TASK_SOFT_TIME_LIMIT=60
CELERY_TASK_TIME_LIMIT=120

# Maximum size for a single uploaded Resource file (20 MiB by default).
RESOURCE_MAX_FILE_SIZE_BYTES=20971520

# Render sends PORT to the web service; do not hard-code it in the start command.
LOG_LEVEL=INFO

# Cloudinary media storage. These must all be set in production; local
# development may leave them unset and use filesystem storage.
# Keep the API secret server-side and never expose it to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESOURCE_FOLDER=studymate/resources

# Comma-separated values; do not include a URL scheme in ALLOWED_HOSTS.
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact frontend origin. Use the HTTPS Vercel URL in production.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render production example. Replace the Vercel origin with the exact browser
# origin used by the deployed frontend (no path or trailing slash). Keep
# JWT_COOKIE_DOMAIN unset: the cookies belong to the Render API host when the
# frontend uses VITE_API_BASE_URL directly, or to the Vercel host when the
# /api/* rewrite in vercel.json is used.
# ALLOWED_HOSTS=studymate-fxdd.onrender.com
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# JWT_COOKIE_SAMESITE=None
# JWT_COOKIE_SECURE=True
# CSRF_COOKIE_SAMESITE=None
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# JWT_TOKEN_BLACKLIST_ENABLED=True
# JWT_COOKIE_DOMAIN=

# JWT authentication (the signing key defaults to SECRET_KEY when omitted).
JWT_SIGNING_KEY=replace-with-a-separate-jwt-signing-key
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ACCESS_COOKIE_NAME=studymate_access
JWT_REFRESH_COOKIE_NAME=studymate_refresh
JWT_COOKIE_SAMESITE=Lax

# Cross-site Vercel -> Render cookie authentication requires these production values:
# JWT_COOKIE_SAMESITE=None
# JWT_COOKIE_SECURE=True
# JWT_TOKEN_BLACKLIST_ENABLED=True

# Keep JWT_COOKIE_SECURE unset for local HTTP; set it to True in HTTPS production.
# JWT_COOKIE_SECURE=True
# JWT_COOKIE_DOMAIN=.example.com
# JWT_ACCESS_COOKIE_PATH=/
# JWT_REFRESH_COOKIE_PATH=/api/auth/

# Signup email verification. Configure the usual Django email backend/SMTP
# settings for deployment; the OTP itself is never stored or returned.
# DEFAULT_FROM_EMAIL=no-reply@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# SIGNUP_OTP_TTL_SECONDS=600
# SIGNUP_OTP_MAX_ATTEMPTS=5
# SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
# SIGNUP_OTP_EMAIL_RATE_LIMIT=5
# SIGNUP_OTP_EMAIL_RATE_WINDOW_SECONDS=3600

# Retention cleanup is disabled unless explicitly approved and configured.
# It only targets completed signup-verification bookkeeping after the OTP
# expiry plus this explicit post-expiry window. It never targets user history,
# notifications, analytics events, or security/audit records.
# RETENTION_CLEANUP_ENABLED=False
# SIGNUP_VERIFICATION_CLEANUP_RETENTION_SECONDS=0
# RETENTION_CLEANUP_BATCH_SIZE=100
# RETENTION_CLEANUP_MAX_BATCHES=10
# RETENTION_CLEANUP_BATCH_PAUSE_SECONDS=0

# Production only (DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# DRF API throttling. Defaults are conservative and may be tuned per deployment.
# THROTTLE_ANON_RATE=300/hour
# THROTTLE_USER_RATE=1200/hour
# THROTTLE_AUTH_LOGIN_RATE=30/minute
# THROTTLE_AUTH_SIGNUP_RATE=20/hour
# THROTTLE_AUTH_REFRESH_RATE=60/minute
# THROTTLE_RESOURCE_WRITE_RATE=60/hour
# THROTTLE_QUESTION_WRITE_RATE=60/hour
# THROTTLE_ANSWER_WRITE_RATE=120/hour
# THROTTLE_INTERACTION_WRITE_RATE=300/minute
# THROTTLE_ONBOARDING_WRITE_RATE=60/hour
# THROTTLE_EVENT_WRITE_RATE=300/minute
